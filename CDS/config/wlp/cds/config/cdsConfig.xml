<cds>
  <!-- Configure your local contest and data folder (used to find or store config files, resources, etc.) -->
  <contest path="/home/myuser/contests/test" recordReactions="false">
    <!-- Configure your CCS via REST -->
    <!--
    <ccs url="https://my-ccs" user="" password=""/>
    -->

    <!-- Uncomment to enable test (contest playback) mode. Countdown in seconds *or* specific start time, and contest speed multiplier -->
    <!--
    <test countdown="30" startTime="2020-02-19T12:30:00.000-05" multiplier="10.0"/>
    -->
  
    <!-- Uncomment and configure if your contest has team desktop, webcam, or audio streaming -->
    <!--
    <video desktop="http://10.1.1.{0}:9090" webcam="http://10.1.1.{0}:8080" audio="http://10.1.1.{0}:7070"/>
    -->
    <!-- Or map team desktop, webcam, or audio streaming individually to each team by id -->
    <!--
    <video id="3" desktop="http://10.1.1.203:9090" webcam="http://10.1.1.203:8080" audio="http://10.1.1.203:7070"/>
    -->
  </contest>

  <!-- Sync external albums into present/photos for the existing Photos presentation.
       apiKey is a Flickr API key; do not commit a real key. refresh is seconds (default 300).
       Saving this file reloads the source list without a restart.
  <photos refresh="300" apiKey="">
    <source uri="flickr://album/ALBUM_ID"/>
  </photos>
  -->

  <!-- Administrative domains. Uncomment and duplicate to set up multiple presentation domains.
       Each domain must have one or more admins and one or more clients -->
  <!--
  <domain>
    <user name="presAdmin"/>
    <user name="presentation"/>
  </domain>
  -->
</cds>