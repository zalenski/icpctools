    font-weight: 600;
  }
  .reviewed-count { color: var(--green); font-size: 13px; font-weight: 600; white-space: nowrap; }
  .panes { flex: 1 1 auto; display: flex; min-height: 0; }
  .walk-pane, .diff-pane { min-height: 0; min-width: 0; overflow: auto; }
  .walk-pane {
    flex: 0 0 420px;
    width: 420px;
    background: var(--canvas);
    border-right: 1px solid var(--line);
    padding: 20px 22px 85vh;
  }
  .diff-pane { flex: 1 1 auto; background: var(--soft); padding: 12px 12px 90vh; }
  .walk-title { font-size: 22px; line-height: 1.25; margin: 0 0 10px; }
  .walk-intro { font-size: 14px; line-height: 1.55; }
  .walk-section {
    margin-top: 16px;
    padding: 8px 8px 10px 12px;
    border-left: 3px solid transparent;
    border-radius: 0 8px 8px 0;
  }
  .walk-section.is-active { background: var(--soft); border-left-color: var(--blue); }
  .walk-section.is-reviewed .walk-body { opacity: 0.62; }
  .walk-section.is-reviewed:not(.is-active) { border-left-color: var(--green); }
  .walk-section-head { display: flex; gap: 10px; align-items: flex-start; }
  .walk-section-head h2 { margin: 0; font-size: 16px; line-height: 1.35; font-weight: 600; flex: 1; }
  .walk-reviewed { accent-color: var(--green); width: 16px; height: 16px; margin: 3px 0 0; flex: 0 0 auto; }
  .walk-jump {
    display: flex;
    gap: 8px;
    align-items: baseline;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .walk-jump:hover { color: var(--blue); }
  .walk-jump.is-static { cursor: default; }
  .walk-jump.is-static:hover { color: inherit; }
  .walk-index { color: var(--blue); font-size: 12px; font-weight: 700; min-width: 1.2em; }
  .walk-body, .walk-intro { overflow-wrap: break-word; }
  .walk-body p, .walk-intro p { margin: 8px 0; }
  .walk-body ul, .walk-body ol, .walk-intro ul, .walk-intro ol { margin: 8px 0; padding-left: 1.25em; }
  .walk-body h3, .walk-intro h3 { font-size: 15px; margin: 14px 0 6px; }
  .walk-pane code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    background: #eff1f3;
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .walk-pane pre {
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 10px 12px;
    overflow: auto;
  }
  .walk-pane pre code { background: none; padding: 0; }
  .ref-link {
    display: inline;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    line-height: 1.45;
    color: var(--blue);
    background: var(--blue-soft);
    border: 1px solid #54aeff66;
    border-radius: 6px;
    padding: 0 6px;
    cursor: pointer;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .ref-link:hover { background: #b6e3ff; }
  .ref-link.is-broken {
    color: var(--amber);
    background: #fff1e5;
    border-color: var(--amber-line);
  }
  .walk-warning {
    margin: 8px 0 0;
    padding: 8px 10px;
    background: var(--amber-bg);
    border: 1px solid var(--amber-line);
    border-radius: 6px;
    color: #4d2d00;
    font-size: 13px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .walk-loading, .walk-load-error, .walk-empty { margin: 8px; color: var(--muted); }
  .walk-load-error {
    color: #4d2d00;
    background: var(--amber-bg);
    border: 1px solid var(--amber-line);
    border-radius: 6px;
    padding: 10px 12px;
  }
  .walk-backs { display: inline-flex; gap: 3px; margin-right: 6px; vertical-align: text-bottom; }
  .walk-back {
    appearance: none;
    border: 0;
    background: var(--blue);
    color: #fff;
    font: 700 10px/16px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    cursor: pointer;
  }
  .walk-back:hover { background: #0550ae; }
  .d2h-file-header .walk-backs { margin-right: 8px; }
  tr.walk-hit > td { box-shadow: inset 0 0 0 9999px rgba(9, 105, 218, 0.16); }
  tr.walk-hit-start > td { box-shadow: inset 3px 0 0 #0969da, inset 0 0 0 9999px rgba(9, 105, 218, 0.2); }
  tr.walk-hit-end > td { box-shadow: inset 0 -2px 0 #0969da, inset 0 0 0 9999px rgba(9, 105, 218, 0.16); }
  tr.walk-hit-start.walk-hit-end > td { box-shadow: inset 3px 0 0 #0969da, inset 0 0 0 9999px rgba(9, 105, 218, 0.22); }
  .d2h-file-wrapper.walk-file-focus > .d2h-file-header {
    box-shadow: inset 3px 0 0 #0969da, inset 0 0 0 9999px rgba(9, 105, 218, 0.12);
  }
  .ref-link:focus-visible, .walk-back:focus-visible, .walk-jump:focus-visible, .walk-reviewed:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .walk-flash { animation: walk-flash 0.9s ease; }
  @keyframes walk-flash {
    0% { background: #ddf4ff; }
    100% { background: transparent; }
  }
  @media (max-width: 860px) {
    .walk-pane { flex-basis: 320px; width: 320px; }
  }
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="topbar-title">
      <span class="product">Diff walkthrough</span>
      <code class="range-chip" id="range-chip"></code>
    </div>
    <div class="topbar-meta">
      <span class="attention" id="attention" hidden></span>
      <span class="reviewed-count" id="reviewed-count"></span>
      <button type="button" id="clear-reviewed" hidden>Clear review marks</button>
    </div>
  </header>
  <div class="panes">
    <aside class="walk-pane" id="walk" aria-label="Walkthrough">
      <p class="walk-loading">Loading walkthrough...</p>
    </aside>
    <main class="diff-pane" id="diff" aria-label="Diff">
      <p class="walk-loading">Loading diff...</p>
    </main>
  </div>
</div>
<noscript>
  <p class="walk-load-error">This page needs JavaScript to render the walkthrough and the diff.</p>
</noscript>
<script type="application/json" id="walk-data">@@PAYLOAD@@</script>
<script src="@@JS@@"></script>
<script>
"use strict";

var DATA = JSON.parse(document.getElementById("walk-data").textContent);
var walkPane = document.getElementById("walk");
var diffPane = document.getElementById("diff");
var sections = [];
var sectionById = {};
var wrappers = [];
var lineMaps = [];
var diffReady = false;

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function scrollBehavior(instant) {
  if (instant || document.documentElement.getAttribute("data-instant") === "1") {
    return "auto";
  }
  if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    return "auto";
  }
  return "smooth";
}

function scrollPaneTo(pane, el, instant) {
  var paneRect = pane.getBoundingClientRect();
  var elRect = el.getBoundingClientRect();
  var next = pane.scrollTop + (elRect.top - paneRect.top) - 56;
  if (next < 0) {
    next = 0;
  }
  pane.scrollTo({top: next, behavior: scrollBehavior(instant)});
}

function flash(el) {
  if (!el) {
    return;
  }
  el.classList.remove("walk-flash");
  void el.offsetWidth;
  el.classList.add("walk-flash");
}

function loadState() {
  try {
    var raw = localStorage.getItem(DATA.storageKey);
    if (!raw) {
      return {};
    }
    var parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== "object") {
      return {};
    }
    return parsed;
  } catch (err) {
    return {};
  }
}

function saveState(state) {
  try {
    if (Object.keys(state).length) {
      localStorage.setItem(DATA.storageKey, JSON.stringify(state));
    } else {
      localStorage.removeItem(DATA.storageKey);
    }
  } catch (err) {
    return;
  }
}

function clearReviewed() {
  saveState({});
  for (var box of document.querySelectorAll(".walk-reviewed:checked")) {
    box.checked = false;
    box.closest(".walk-section").classList.remove("is-reviewed");
  }
  updateReviewed();
}

function updateReviewed() {
  var boxes = document.querySelectorAll(".walk-reviewed");
  var done = 0;
  var index;
  for (index = 0; index < boxes.length; index += 1) {
    if (boxes[index].checked) {
      done += 1;
    }
  }
  var el = document.getElementById("reviewed-count");
  var clear = document.getElementById("clear-reviewed");
  clear.hidden = !boxes.length;
  clear.disabled = !done && !Object.keys(loadState()).length;
  if (!boxes.length) {
    el.hidden = true;
    return;
  }
  el.hidden = false;
  el.textContent = "Reviewed " + done + "/" + boxes.length;
}

function updateAttention() {
  var unresolved = 0;
  var s;
  var r;
  for (s = 0; s < sections.length; s += 1) {
    for (r = 0; r < sections[s].refs.length; r += 1) {
      var ref = sections[s].refs[r];
      var quiet = (ref.status === "ok" || ref.status === "file") && ref.jump !== "none";
      if (!quiet) {
        unresolved += 1;
      }
    }
  }
  var el = document.getElementById("attention");
  if (!unresolved) {
    el.hidden = true;
    el.textContent = "";
    return;
  }
  el.hidden = false;
  el.textContent = unresolved === 1 ? "1 reference needs attention" : unresolved + " references need attention";
}

function isFence(line) {
  return /^ {0,3}```/.test(line);
}

function isBlockStart(line) {
  if (isFence(line)) {
    return true;
  }
  if (/^ {0,3}#{1,6}\s/.test(line)) {
    return true;
  }
  if (/^ {0,3}>\s?/.test(line)) {
    return true;
  }
  if (/^ {0,3}[-*]\s/.test(line)) {
    return true;
  }
  if (/^ {0,3}\d+\.\s/.test(line)) {
    return true;
  }
  if (/^ {0,3}([-*_])\1{2,}\s*$/.test(line)) {
    return true;
  }
  return false;
}

function safeUrl(url) {
  var trimmed = String(url || "").trim();
  if (/^(https?:\/\/|mailto:)/i.test(trimmed)) {
    return trimmed;
  }
  return "";
}

function renderCode(content, refs, cursor, sectionId) {
  var text = content.trim();
  var ref = refs[cursor.n];
  if (ref && ref.raw === text) {
    var index = cursor.n;
    cursor.n += 1;
    var label = escapeHtml(ref.raw).split("/").join("/<wbr>");
    return '<button type="button" class="ref-link" data-section-id="' + escapeHtml(sectionId) + '" data-ref-index="' + index + '">' + label + "</button>";
  }
  return "<code>" + escapeHtml(content) + "</code>";
}

function renderInline(raw, refs, cursor, sectionId) {
  var html = "";
  var i = 0;
  while (i < raw.length) {
    if (raw.charAt(i) === "`") {
      var endCode = raw.indexOf("`", i + 1);
      if (endCode === -1) {
        html += escapeHtml(raw.slice(i));
        break;
      }
      html += renderCode(raw.slice(i + 1, endCode), refs, cursor, sectionId);
      i = endCode + 1;
      continue;
    }
    if (raw.startsWith("**", i)) {
      var endBold = raw.indexOf("**", i + 2);
      if (endBold !== -1) {
        html += "<strong>" + renderInline(raw.slice(i + 2, endBold), refs, cursor, sectionId) + "</strong>";
        i = endBold + 2;
        continue;
      }
    }
    if (raw.charAt(i) === "*" && raw.charAt(i + 1) !== "*") {
      var endEm = raw.indexOf("*", i + 1);
      if (endEm > i + 1) {
        html += "<em>" + renderInline(raw.slice(i + 1, endEm), refs, cursor, sectionId) + "</em>";
        i = endEm + 1;
        continue;
      }
    }
    if (raw.charAt(i) === "[") {
      var labelEnd = raw.indexOf("](", i + 1);
      if (labelEnd !== -1) {
        var urlEnd = raw.indexOf(")", labelEnd + 2);
        if (urlEnd !== -1) {
          var label = raw.slice(i + 1, labelEnd);
          var href = safeUrl(raw.slice(labelEnd + 2, urlEnd));
          var inner = renderInline(label, refs, cursor, sectionId);
          if (href) {
            html += '<a href="' + escapeHtml(href) + '" rel="noreferrer">' + inner + "</a>";
          } else {
            html += inner;
          }
          i = urlEnd + 1;
          continue;
        }
      }
    }
    var next = raw.length;
    var specials = ["`", "*", "["];
    var s;
    for (s = 0; s < specials.length; s += 1) {
      var at = raw.indexOf(specials[s], i);
      if (raw.charAt(i) === specials[s]) {
        at = i;
      }
      if (at !== -1 && at >= i && at < next) {
        if (at === i) {
          next = i + 1;
        } else {
          next = at;
        }
      }
    }
    html += escapeHtml(raw.slice(i, next));
    i = next;
  }
  return html;
}

function renderMarkdown(src, refs, cursor, sectionId) {
  var lines = String(src || "").replace(/\r\n/g, "\n").split("\n");
  var html = [];
  var i = 0;
  while (i < lines.length) {
    var line = lines[i];
    if (isFence(line)) {
      var buf = [];
      i += 1;
      while (i < lines.length && !isFence(lines[i])) {
        buf.push(lines[i]);
        i += 1;
      }
      if (i < lines.length) {
        i += 1;
      }
      html.push("<pre><code>" + escapeHtml(buf.join("\n")) + "</code></pre>");
      continue;
    }
    if (line.trim() === "") {
      i += 1;
      continue;
    }
    var heading = /^ {0,3}(#{1,6})\s+(.*)$/.exec(line);
    if (heading) {
      var level = heading[1].length;
      if (level < 3) {
        level = 3;
      }
      html.push("<h" + level + ">" + renderInline(heading[2], refs, cursor, sectionId) + "</h" + level + ">");
      i += 1;
      continue;
    }
    if (/^ {0,3}([-*_])\1{2,}\s*$/.test(line)) {
      html.push("<hr>");
      i += 1;
      continue;
    }
    if (/^ {0,3}>\s?/.test(line)) {
      var quoted = [];
      while (i < lines.length && /^ {0,3}>\s?/.test(lines[i])) {
        quoted.push(lines[i].replace(/^ {0,3}>\s?/, ""));
        i += 1;
      }
      html.push("<blockquote>" + renderMarkdown(quoted.join("\n"), refs, cursor, sectionId) + "</blockquote>");
      continue;
    }
    if (/^ {0,3}[-*]\s+/.test(line)) {
      var items = [];
      while (i < lines.length && /^ {0,3}[-*]\s+/.test(lines[i])) {
        var item = lines[i].replace(/^ {0,3}[-*]\s+/, "");
        items.push("<li>" + renderInline(item, refs, cursor, sectionId) + "</li>");
        i += 1;
      }
      html.push("<ul>" + items.join("") + "</ul>");
      continue;
    }
    if (/^ {0,3}\d+\.\s+/.test(line)) {
      var ordered = [];
      while (i < lines.length && /^ {0,3}\d+\.\s+/.test(lines[i])) {
        var text = lines[i].replace(/^ {0,3}\d+\.\s+/, "");
        ordered.push("<li>" + renderInline(text, refs, cursor, sectionId) + "</li>");
        i += 1;
      }
      html.push("<ol>" + ordered.join("") + "</ol>");
      continue;
    }
    var para = [];
    while (i < lines.length && lines[i].trim() !== "" && !isBlockStart(lines[i])) {
      para.push(lines[i].trim());
      i += 1;
    }
    html.push("<p>" + renderInline(para.join(" "), refs, cursor, sectionId) + "</p>");
  }
  return html.join("\n");
}

function bindReview(section, input, article) {
  var state = loadState();
  if (state[section.id]) {
    input.checked = true;
    article.classList.add("is-reviewed");
  }
  input.addEventListener("change", function () {
    var current = loadState();
    if (input.checked) {
      current[section.id] = true;
    } else {
      delete current[section.id];
    }
    saveState(current);
    article.classList.toggle("is-reviewed", input.checked);
    updateReviewed();
  });
}

function showWarnings(section) {
  var host = section.warningsHost;
  if (!host) {
    return;
  }
  host.textContent = "";
  var i;
  for (i = 0; i < section.warningTexts.length; i += 1) {
    var paragraph = document.createElement("p");
    paragraph.className = "walk-warning";
    paragraph.textContent = section.warningTexts[i];
    host.appendChild(paragraph);
  }
}

function renderWalk() {
  walkPane.textContent = "";
  var title = document.createElement("h1");
  title.className = "walk-title";
  title.id = "section-intro";
  title.textContent = DATA.title || "Diff walkthrough";
  walkPane.appendChild(title);
  var introHost = document.createElement("div");
  introHost.className = "walk-intro";
  var introWarnings = document.createElement("div");
  introWarnings.className = "walk-warnings";
  if ((DATA.intro || "").trim() || (DATA.introRefs || []).length) {
    var introCursor = {n: 0};
    introHost.innerHTML = renderMarkdown(DATA.intro || "", DATA.introRefs || [], introCursor, "intro");
    walkPane.appendChild(introHost);
    walkPane.appendChild(introWarnings);
  }
  var introSection = {
    id: "intro",
    title: DATA.title || "Introduction",
    refs: DATA.introRefs || [],
    el: introHost,
    headingButton: null,
    warningsHost: introWarnings,
    warningTexts: [],
    number: "",
    primary: null,
    review: false
  };
  if (introSection.refs.length) {
    sections.push(introSection);
    sectionById.intro = introSection;
  }
  var index;
  for (index = 0; index < DATA.sections.length; index += 1) {
    var source = DATA.sections[index];
    var article = document.createElement("article");
    article.className = "walk-section";
    article.id = "section-" + source.id;
    var head = document.createElement("div");
    head.className = "walk-section-head";
    var input = document.createElement("input");
    input.type = "checkbox";
    input.className = "walk-reviewed";
    input.setAttribute("aria-label", "Mark reviewed: " + source.title);
    var heading = document.createElement("h2");
    var button = document.createElement("button");
    button.type = "button";
    button.className = "walk-jump";
    button.setAttribute("data-primary", "1");
    button.setAttribute("data-section-id", source.id);
    var number = document.createElement("span");
    number.className = "walk-index";
    number.textContent = String(index + 1);
    var label = document.createElement("span");
    label.className = "walk-label";
    label.textContent = source.title;
    button.appendChild(number);
    button.appendChild(label);
    heading.appendChild(button);
    head.appendChild(input);
    head.appendChild(heading);
    var warnings = document.createElement("div");
    warnings.className = "walk-warnings";
    var body = document.createElement("div");
    body.className = "walk-body";
    var cursor = {n: 0};
    body.innerHTML = renderMarkdown(source.markdown || "", source.refs || [], cursor, source.id);
    article.appendChild(head);
    article.appendChild(warnings);
    article.appendChild(body);
    walkPane.appendChild(article);
    var section = {
      id: source.id,
      title: source.title,
      refs: source.refs || [],
      el: article,
      headingButton: button,
      warningsHost: warnings,
      warningTexts: [],
      number: String(index + 1),
      primary: null,
      review: true,
      renderedRefs: cursor.n
    };
    sections.push(section);
    sectionById[section.id] = section;
    bindReview(section, input, article);
  }
  updateReviewed();
}

function diffConstructor() {
  if (typeof Diff2HtmlUI === "function") {
    return Diff2HtmlUI;
  }
  if (typeof Diff2HtmlUI === "object" && Diff2HtmlUI && typeof Diff2HtmlUI.Diff2HtmlUI === "function") {
    return Diff2HtmlUI.Diff2HtmlUI;
  }
  return null;
}

function drawDiff() {
  if (!String(DATA.diff || "").trim()) {
    diffPane.innerHTML = '<p class="walk-empty">This range has no diff.</p>';
    return;
  }
  var Ctor = diffConstructor();
  if (!Ctor) {
    diffPane.innerHTML = '<p class="walk-load-error">Could not load diff2html from the CDN. Check the network connection and reload.</p>';
    return;
  }
  try {
    var ui = new Ctor(diffPane, DATA.diff, {
      drawFileList: true,
      fileListToggle: true,
      fileListStartVisible: true,
      fileContentToggle: true,
      matching: "lines",
      outputFormat: DATA.outputFormat || "line-by-line",
      highlight: true,
      colorScheme: "light",
      stickyFileHeaders: true,
      synchronisedScroll: true
    });
    ui.draw();
    diffReady = true;
  } catch (err) {
    diffPane.innerHTML = '<p class="walk-load-error">The diff viewer failed: ' + escapeHtml(err && err.message ? err.message : err) + "</p>";
  }
}

function parseLineNumber(text) {
  var trimmed = String(text || "").replace(/\u200b/g, "").trim();
  if (!/^\d+$/.test(trimmed)) {
    return null;
  }
  return parseInt(trimmed, 10);
}

function indexWrapper(wrapper) {
  var map = new Map();
  var sides = wrapper.querySelectorAll(".d2h-file-side-diff");
  var sideBySide = sides.length >= 2;
  var root = sideBySide ? sides[1] : wrapper;
  var rows = root.querySelectorAll("tr");
  var i;
  for (i = 0; i < rows.length; i += 1) {
    var tr = rows[i];
    var number = null;
    if (sideBySide) {
      var cell = tr.querySelector("td.d2h-code-side-linenumber");
      number = cell ? parseLineNumber(cell.textContent) : null;
    } else {
      var node = tr.querySelector(".line-num2");
      number = node ? parseLineNumber(node.textContent) : null;
    }
    if (number === null || map.has(number)) {
      continue;
    }
    tr.setAttribute("data-line", String(number));
    map.set(number, tr);
  }
  return map;
}

function fileLabel(wrapper) {
  var el = wrapper.querySelector(".d2h-file-name");
  if (!el) {
    return "";
  }
  return el.textContent.replace(/\s+/g, " ").trim();
}

function baseName(path) {
  if (!path) {
    return "";
  }
  var parts = path.split("/");
  return parts[parts.length - 1];
}

function candidatePaths(file) {
  var paths = [];
  if (file.new && file.new !== "/dev/null") {
    paths.push(file.new);
  }
  if (file.old && file.old !== "/dev/null") {
    paths.push(file.old);
  }
  return paths;
}

function nameMatches(wrapper, file, basenameOk) {
  var label = fileLabel(wrapper);
  var paths = candidatePaths(file);
  var i;
  for (i = 0; i < paths.length; i += 1) {
    if (label === paths[i]) {
