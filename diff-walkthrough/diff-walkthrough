#!/usr/bin/env python3
"""Render a git diff beside a markdown walkthrough.

The walkthrough cites new-side line ranges such as ``path/File.java:120-140``.
This script runs ``git diff -U3``, resolves those citations against the hunks,
and writes one HTML file. The page loads diff2html from a CDN, scrolls the
walkthrough and the diff independently, and jumps from a section to the lines
it cites.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
import webbrowser
from pathlib import Path

DIFF2HTML_VERSION = "3.4.56"
DIFF2HTML_CSS = (
    f"https://cdn.jsdelivr.net/npm/diff2html@{DIFF2HTML_VERSION}/bundles/css/diff2html.min.css"
)
DIFF2HTML_JS = (
    f"https://cdn.jsdelivr.net/npm/diff2html@{DIFF2HTML_VERSION}/bundles/js/diff2html-ui.min.js"
)

_LOCATION_RE = re.compile(r"^(?P<path>.+?):(?P<start>\d+)(?:-(?P<end>\d+))?$")
_HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(?P<start>\d+)(?:,\d+)? @@")
_FENCE_RE = re.compile(r"^ {0,3}```")
_H1_RE = re.compile(r"^ {0,3}#\s+(.*)$")
_H2_RE = re.compile(r"^ {0,3}##\s+(.*)$")
_CODE_SPAN_RE = re.compile(r"`([^`]+)`")
_TRAILING_HASHES_RE = re.compile(r"\s+#+\s*$")


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def _parse_git_path_token(text: str, index: int) -> tuple[str, int]:
    """Read one path from a git diff header, honoring C-style quotes."""
    if index >= len(text):
        return "", index
    if text[index] != '"':
        end = index
        while end < len(text) and text[end] != " ":
            end += 1
        return text[index:end], end
    data = bytearray()
    cursor = index + 1
    while cursor < len(text):
        char = text[cursor]
        if char == '"':
            return data.decode("utf-8", "surrogateescape"), cursor + 1
        if char == "\\" and cursor + 1 < len(text):
            nxt = text[cursor + 1]
            if nxt in "01234567":
                digits = ""
                digit_at = cursor + 1
                while digit_at < len(text) and len(digits) < 3 and text[digit_at] in "01234567":
                    digits += text[digit_at]
                    digit_at += 1
                data.append(int(digits, 8))
                cursor = digit_at
                continue
            simple = {
                "n": 10,
                "t": 9,
                "r": 13,
                "\\": 92,
                '"': 34,
                "a": 7,
                "b": 8,
                "f": 12,
                "v": 11,
            }
            if nxt in simple:
                data.append(simple[nxt])
                cursor += 2
                continue
        data.extend(char.encode("utf-8"))
        cursor += 1
    return data.decode("utf-8", "surrogateescape"), cursor


def _strip_ab_prefix(path: str) -> str:
    if path == "/dev/null":
        return path
    if path.startswith("a/") or path.startswith("b/"):
        return path[2:]
    return path


def _split_diff_paths(line: str) -> tuple[str, str] | None:
    if line.startswith("diff --cc ") or line.startswith("diff --combined "):
        rest = line.split(" ", 2)[2]
        token, _ = _parse_git_path_token(rest, 0)
        path = _strip_ab_prefix(token)
        return path, path
    if not line.startswith("diff --git "):
        return None
    rest = line[len("diff --git ") :]
    old, index = _parse_git_path_token(rest, 0)
    if index < len(rest) and rest[index] == " ":
        index += 1
    new, _ = _parse_git_path_token(rest, index)
    return _strip_ab_prefix(old), _strip_ab_prefix(new)


def _parse_file_header_path(line: str) -> str:
    rest = line[4:].split("\t", 1)[0]
    token, _ = _parse_git_path_token(rest, 0)
    return _strip_ab_prefix(token)


def parse_unified_diff(diff_text: str) -> list[dict]:
    """Return one record per file in a unified diff.

    ``new_lines`` is the set of new-side line numbers that appear as additions
    or as context. Those are the lines a walkthrough is allowed to cite.
    """
    files: list[dict] = []
    current: dict | None = None
    new_line: int | None = None

    def start_file(old: str, new: str, combined: bool) -> None:
        nonlocal current, new_line
        current = {
            "old": old,
            "new": new,
            "new_lines": set(),
            "binary": False,
            "deleted": False,
            "combined": combined,
        }
        files.append(current)
        new_line = None

    for line in diff_text.splitlines():
        paths = _split_diff_paths(line)
        if paths is not None:
            start_file(paths[0], paths[1], line.startswith("diff --cc ") or line.startswith("diff --combined "))
            continue
        if current is None:
            continue
        if line.startswith("deleted file mode"):
            current["deleted"] = True
            continue
        if line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            current["binary"] = True
            new_line = None
            continue
        if current["binary"]:
            continue
        if new_line is None and line.startswith("--- "):
            current["old"] = _parse_file_header_path(line)
            continue
        if new_line is None and line.startswith("+++ "):
            current["new"] = _parse_file_header_path(line)
            if current["new"] == "/dev/null":
                current["deleted"] = True
            continue
        if line.startswith("@@@"):
            current["combined"] = True
            new_line = None
            continue
        hunk = _HUNK_RE.match(line)
        if hunk:
            new_line = int(hunk.group("start"))
            continue
        if new_line is None or current["combined"]:
            continue
        if line.startswith("\\"):
            continue
        if line.startswith("+"):
            current["new_lines"].add(new_line)
            new_line += 1
            continue
        if line.startswith("-"):
            continue
        if line.startswith(" "):
            current["new_lines"].add(new_line)
            new_line += 1
    return files


def known_paths(files: list[dict]) -> set[str]:
    paths: set[str] = set()
    for file in files:
        if file["new"] and file["new"] != "/dev/null":
            paths.add(file["new"])
        if file["old"] and file["old"] != "/dev/null":
            paths.add(file["old"])
    return paths


def _looks_like_location(path: str) -> bool:
    if not path or path != path.strip():
        return False
    if "://" in path:
        return False
    if "/" not in path and "." not in path:
        return False
    return True


def _blank_ref(raw: str, path: str, start: int | None, end: int | None) -> dict:
    return {
        "raw": raw,
        "path": path,
        "start": start,
        "end": end,
        "fileIndex": None,
        "status": "unresolved",
        "jump": "none",
        "message": None,
    }


def classify_span(content: str, paths: set[str]) -> dict | None:
    """Return a reference when a code span cites a file or a new-side range."""
    text = content.strip()
    match = _LOCATION_RE.match(text)
    if match:
        path = match.group("path").strip()
        if _looks_like_location(path):
            start = int(match.group("start"))
            end = int(match.group("end")) if match.group("end") else start
            return _blank_ref(text, path, start, end)
    if text in paths:
        return _blank_ref(text, text, None, None)
    return None


def iter_code_spans(markdown: str) -> list[str]:
    spans: list[str] = []
    in_fence = False
    for line in markdown.split("\n"):
        if _FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        for match in _CODE_SPAN_RE.finditer(line):
            spans.append(match.group(1))
    return spans


def extract_refs(markdown: str, paths: set[str]) -> list[dict]:
    refs: list[dict] = []
    for span in iter_code_spans(markdown):
        ref = classify_span(span, paths)
        if ref is not None:
            refs.append(ref)
    return refs


def _slugify(text: str) -> str:
    slug = text.lower().replace("`", "")
    slug = re.sub(r"[^a-z0-9]+", "-", slug).strip("-")
    return slug[:60] or "section"


def parse_walkthrough(markdown: str, paths: set[str]) -> dict:
    text = markdown.replace("\r\n", "\n").replace("\r", "\n")
    if text.startswith("\ufeff"):
        text = text[1:]
    lines = text.split("\n")
    title: str | None = None
    title_index: int | None = None
    section_at: list[tuple[int, str]] = []
    in_fence = False
    for index, line in enumerate(lines):
        if _FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if title is None and not section_at:
            heading = _H1_RE.match(line)
            if heading and not line.lstrip().startswith("##"):
                title = heading.group(1).strip()
                title_index = index
                continue
        heading = _H2_RE.match(line)
        if heading:
            name = _TRAILING_HASHES_RE.sub("", heading.group(1).strip())
            section_at.append((index, name))
    if title_index is None:
        intro_lines = lines[: section_at[0][0]] if section_at else lines
    else:
        intro_lines = lines[:title_index] + lines[title_index + 1 : (section_at[0][0] if section_at else len(lines))]
    intro = "\n".join(intro_lines).strip("\n")
    used: set[str] = set()
    sections: list[dict] = []
    for position, (start, name) in enumerate(section_at):
        end = section_at[position + 1][0] if position + 1 < len(section_at) else len(lines)
        body = "\n".join(lines[start + 1 : end]).strip("\n")
        base = _slugify(name)
        slug = base
        suffix = 2
        while slug in used:
            slug = f"{base}-{suffix}"
            suffix += 1
        used.add(slug)
        sections.append(
            {
                "id": slug,
                "title": name,
                "markdown": body,
                "refs": extract_refs(body, paths),
            }
        )
    return {
        "title": title or "Diff walkthrough",
        "intro": intro,
        "introRefs": extract_refs(intro, paths),
        "sections": sections,
    }


def _compress_ranges(numbers: set[int]) -> list[list[int]]:
    if not numbers:
        return []
    ordered = sorted(numbers)
    ranges: list[list[int]] = []
    start = prev = ordered[0]
    for number in ordered[1:]:
        if number == prev + 1:
            prev = number
            continue
        ranges.append([start, prev])
        start = prev = number
    ranges.append([start, prev])
    return ranges


def _format_lines(numbers: list[int]) -> str:
    if not numbers:
        return ""
    groups: list[str] = []
    start = prev = numbers[0]
    for number in numbers[1:]:
        if number == prev + 1:
            prev = number
            continue
        groups.append(str(start) if start == prev else f"{start}-{prev}")
        start = prev = number
    groups.append(str(start) if start == prev else f"{start}-{prev}")
    if len(groups) > 6:
        hidden = len(groups) - 6
        return ", ".join(groups[:6]) + f", and {hidden} more"
    return ", ".join(groups)


def _matching_indexes(files: list[dict], path: str) -> tuple[list[int], list[int]]:
    new_hits = [index for index, file in enumerate(files) if file["new"] == path]
    old_hits = [
        index
        for index, file in enumerate(files)
        if file["old"] == path and file["new"] != path
    ]
    return new_hits, old_hits


def resolve_ref(ref: dict, files: list[dict]) -> None:
    if ref["start"] is None:
        _resolve_file_ref(ref, files)
        return
    if ref["end"] < ref["start"] or ref["start"] < 1:
        ref["status"] = "bad-range"
        ref["jump"] = "none"
        ref["message"] = f'{ref["raw"]} is not a valid new-side line range.'
        return
    new_hits, old_hits = _matching_indexes(files, ref["path"])
    renamed = False
    ambiguous = False
    if new_hits:
        index = new_hits[0]
        ambiguous = len(new_hits) > 1
    elif old_hits:
        index = old_hits[0]
        ambiguous = len(old_hits) > 1
        file = files[index]
        if file["deleted"] or file["new"] == "/dev/null":
            ref["fileIndex"] = index
            ref["status"] = "deleted"
            ref["jump"] = "none"
            ref["message"] = (
                f'{ref["path"]} was deleted in this diff, so it has no new-side lines.'
            )
            return
        renamed = True
    else:
        ref["status"] = "missing-file"
        ref["jump"] = "none"
        ref["message"] = f'No file "{ref["path"]}" in this diff.'
        return
    file = files[index]
    ref["fileIndex"] = index
    if file["binary"]:
        ref["status"] = "binary"
        ref["jump"] = "none"
        ref["message"] = f'{ref["path"]} is a binary file in this diff, so it has no line numbers.'
        return
    if file["combined"]:
        ref["status"] = "combined"
        ref["jump"] = "none"
        ref["message"] = (
            f'{ref["path"]} comes from a combined merge diff. '
            "Line links are resolved only for ordinary unified diffs."
        )
        return
    present = [number for number in range(ref["start"], ref["end"] + 1) if number in file["new_lines"]]
    missing = [number for number in range(ref["start"], ref["end"] + 1) if number not in file["new_lines"]]
    notes: list[str] = []
    if renamed:
        notes.append(
            f'{ref["path"]} was renamed to {file["new"]}. '
            f'This link follows the new file; cite {file["new"]} next time.'
        )
    if ambiguous:
        notes.append(f'{ref["path"]} appears more than once in this diff. The link uses the first copy.')
    if not present:
        ref["jump"] = "none"
        ref["status"] = "outside"
        if not file["new_lines"]:
            detail = (
                f'{ref["path"]} is in this diff without line text '
                f'(for example a pure rename or a mode change), so {ref["raw"]} cannot be highlighted.'
            )
        else:
            detail = (
                f'{ref["raw"]} is outside this diff. '
                "Reference added lines, or context lines within 3 lines of a change."
            )
        if notes:
            detail = detail + " " + " ".join(notes)
        ref["message"] = detail
        return
    if missing:
        ref["status"] = "partial"
        ref["jump"] = "lines"
        notes.append(
            f'Some lines in {ref["raw"]} are outside this diff ({_format_lines(missing)}). '
            "The lines that are present are still highlighted."
        )
        ref["message"] = " ".join(notes)
        return
    if notes:
        ref["status"] = "renamed" if renamed else "ambiguous"
        ref["jump"] = "lines"
        ref["message"] = " ".join(notes)
        return
    ref["status"] = "ok"
    ref["jump"] = "lines"
    ref["message"] = None


def _resolve_file_ref(ref: dict, files: list[dict]) -> None:
    new_hits, old_hits = _matching_indexes(files, ref["path"])
    if new_hits:
        index = new_hits[0]
        ambiguous = len(new_hits) > 1
    elif old_hits:
        index = old_hits[0]
        ambiguous = len(old_hits) > 1
    else:
        direct = [index for index, file in enumerate(files) if file["old"] == ref["path"]]
        if not direct:
            ref["status"] = "missing-file"
            ref["jump"] = "none"
            ref["message"] = f'No file "{ref["path"]}" in this diff.'
            return
        index = direct[0]
        ambiguous = len(direct) > 1
    ref["fileIndex"] = index
    ref["status"] = "ambiguous" if ambiguous else "file"
    ref["jump"] = "file"
    ref["message"] = (
        f'{ref["path"]} appears more than once in this diff. The link uses the first copy.'
        if ambiguous
        else None
    )


def resolve_document(files: list[dict], document: dict) -> None:
    for ref in document["introRefs"]:
        resolve_ref(ref, files)
    for section in document["sections"]:
        for ref in section["refs"]:
            resolve_ref(ref, files)


def warning_lines(document: dict) -> list[str]:
    lines: list[str] = []
    label = document["title"] or "Introduction"
    for ref in document["introRefs"]:
        if ref.get("message"):
            lines.append(f"{label}: {ref['message']}")
    for section in document["sections"]:
        for ref in section["refs"]:
            if ref.get("message"):
                lines.append(f"{section['title']}: {ref['message']}")
    return lines


def _public_file(file: dict) -> dict:
    return {
        "old": file["old"],
        "new": file["new"],
        "lines": _compress_ranges(file["new_lines"]),
        "binary": file["binary"],
        "deleted": file["deleted"],
    }


def _storage_key(range_spec: str, sections: list[dict]) -> str:
    identity = range_spec + "\n" + "\n".join(f"{section['id']}\n{section['title']}" for section in sections)
    digest = hashlib.sha256(identity.encode("utf-8")).hexdigest()[:16]
    return f"diff-walkthrough:{digest}"


def build_payload(diff_text: str, markdown: str, range_spec: str, output_format: str) -> dict:
    files = parse_unified_diff(diff_text)
    document = parse_walkthrough(markdown, known_paths(files))
    resolve_document(files, document)
    return {
        "title": document["title"],
        "range": range_spec,
        "outputFormat": output_format,
        "storageKey": _storage_key(range_spec, document["sections"]),
        "intro": document["intro"],
        "introRefs": document["introRefs"],
        "sections": document["sections"],
        "files": [_public_file(file) for file in files],
        "diff": diff_text,
        "warnings": warning_lines(document),
    }


def encode_payload(payload: dict) -> str:
    raw = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
    return raw.replace("<", "\\u003c")


def render_html(payload: dict) -> str:
    return PAGE_TEMPLATE.replace("@@CSS@@", DIFF2HTML_CSS).replace("@@JS@@", DIFF2HTML_JS).replace(
        "@@PAYLOAD@@", encode_payload(payload)
    )


def git_diff(repo: Path, range_spec: str) -> str:
    if not repo.exists():
        die(f"repository not found: {repo}")
    probe = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        text=True,
    )
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        detail = probe.stderr.strip() or f"not a git repository: {repo}"
        die(detail)
    proc = subprocess.run(
        ["git", "-C", str(repo), "diff", "--no-color", "--no-ext-diff", "-U3", range_spec],
        capture_output=True,
        text=True,
        errors="replace",
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or "git diff failed"
        die(detail)
    return proc.stdout


def open_browser(path: Path) -> None:
    uri = path.resolve().as_uri()
    try:
        opened = webbrowser.open(uri)
    except webbrowser.Error as exc:
        print(f"Could not open a browser ({exc}). Open this file instead:\n{uri}", file=sys.stderr)
        return
    if not opened:
        print(f"Could not open a browser. Open this file instead:\n{uri}", file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="diff-walkthrough",
        description=(
            "Write a GitHub-style diff beside a markdown walkthrough and open it "
            "in the default browser. References use new-side line numbers, for "
            "example path/File.java:120-140."
        ),
    )
    parser.add_argument(
        "--range",
        required=True,
        dest="range_spec",
        help="Revision range passed to git diff, such as main...HEAD or COMMIT^..COMMIT.",
    )
    parser.add_argument(
        "--walkthrough",
        required=True,
        help="Markdown file whose ## sections cite files and line ranges.",
    )
    parser.add_argument(
        "--repo",
        default=".",
        help="Git working tree to diff (default: the current directory).",
    )
    parser.add_argument(
        "--side-by-side",
        action="store_true",
        help="Render the diff in two columns. The default is a single unified column.",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="Write the HTML file without opening a browser.",
    )
    parser.add_argument(
        "--out",
        default="diff-walkthrough.html",
        help="Output HTML path (default: diff-walkthrough.html in the current directory).",
    )
    return parser


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    walkthrough_path = Path(args.walkthrough)
    if not walkthrough_path.is_file():
        die(f"walkthrough not found: {walkthrough_path}")
    try:
        markdown = walkthrough_path.read_text(encoding="utf-8")
    except OSError as exc:
        die(f"could not read {walkthrough_path}: {exc}")
    diff_text = git_diff(Path(args.repo).expanduser().resolve(), args.range_spec)
    output_format = "side-by-side" if args.side_by_side else "line-by-line"
    payload = build_payload(diff_text, markdown, args.range_spec, output_format)
    out = Path(args.out).expanduser()
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(render_html(payload), encoding="utf-8")
    except OSError as exc:
        die(f"could not write {out}: {exc}")
    ref_count = len(payload["introRefs"]) + sum(len(section["refs"]) for section in payload["sections"])
    print(f"Wrote {out.resolve()}")
    print(
        f"{len(payload['sections'])} section(s), {ref_count} reference(s), "
        f"{len(payload['warnings'])} warning(s)."
    )
    for warning in payload["warnings"]:
        print(f"warning: {warning}", file=sys.stderr)
    if not args.no_open:
        open_browser(out)


