<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="jar" name="org.icpc.tools.photoimporter">
  <property name="contest.model" value="../ContestModel"/>
  <import file="${contest.model}/common.xml"/>
  <property name="title" value="ICPC Photo Importer"/>
  <property name="jar.name" value="photoImporter"/>
  <target name="stage">
    <copy todir="staging">
      <fileset dir="${contest.model}/staging" includes="contestModel.jar"/>
      <fileset dir="${contest.model}/lib" includes="*.jar"/>
    </copy>
  </target>
  <!-- Optional standalone web build; standard distribution integration is a later step. -->
  <target name="web" depends="jar">
    <exec executable="pnpm" dir="ui" failonerror="true"><arg value="build"/></exec>
    <jar destfile="staging/${jar.name}.jar" update="true">
      <zipfileset dir="ui/build" prefix="photo-ui"/>
    </jar>
  </target>
</project>
